# ⚠️ SECURITY: Never use default values in production!
# Generate secrets with: openssl rand -base64 32

# Database
DATABASE_URL=postgresql://[USER]:[PASSWORD]@[HOST]:5432/[DB]
DB_USER=[your-database-user]
DB_PASSWORD=[GENERATE_SECURE_PASSWORD]

# Security - MUST be generated, minimum 32 characters
JWT_SECRET=[GENERATE_WITH: openssl rand -base64 32]
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=[GENERATE_WITH: openssl rand -base64 32]
ENCRYPTION_KEY=[GENERATE_WITH: openssl rand -hex 32]

# CORS - whitelist only trusted domains (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=[GENERATE_SECURE_PASSWORD]

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=[GENERATE_SECURE_PASSWORD]

# Node Environment
NODE_ENV=development
LOG_LEVEL=info

# GitHub
GITHUB_TOKEN=[your_github_token_here]
GITHUB_REPO=markl-a/Vibe-Coding-Apps

# API Keys (if using AI services)
OPENAI_API_KEY=[your_openai_key_here]
ANTHROPIC_API_KEY=[your_anthropic_key_here]

# Analytics (optional)
ANALYTICS_API_KEY=[your_analytics_key_here]

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=[GENERATE_SECURE_PASSWORD]

# Deployment
VERCEL_TOKEN=[your_vercel_token_here]
