{
  "name": "@vibe/shared-utils",
  "version": "1.0.0",
  "description": "Shared utility functions for Vibe-Coding-Apps",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "utils",
    "utilities",
    "shared"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "eslint": "^8.55.0",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "react": "^18.2.0",
    "redis": "^4.6.11",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  },
  "peerDependencies": {
    "express": "^4.18.0",
    "ioredis": "^5.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "redis": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "redis": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
