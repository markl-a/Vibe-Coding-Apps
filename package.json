{
  "name": "vibe-coding-apps",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Driven and AI-Native Applications Collection",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:report": "playwright show-report",
    "playwright:install": "playwright install --with-deps",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@playwright/test": "^1.40.1",
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.5",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.12.1",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.4.2",
      "react": "^18.2.0",
      "react-dom": "^18.2.0",
      "@types/node": "^20.10.0",
      "eslint": "^8.56.0",
      "vite": "^5.1.0",
      "vitest": "^1.2.0"
    }
  },
  "workspaces": [
    "ai-ml-projects/*",
    "ai-ml-projects/chatbots/*",
    "ai-ml-projects/data-analysis/*",
    "ai-ml-projects/image-processing/*",
    "ai-ml-projects/nlp/*",
    "apis-backend/*",
    "apis-backend/rest-apis/*",
    "apis-backend/graphql-apis/*",
    "apis-backend/microservices/*",
    "blockchain-apps/*",
    "browser-extensions/*",
    "desktop-apps/*",
    "enterprise-apps/*",
    "enterprise-apps/erp-systems/*",
    "enterprise-apps/crm-systems/*",
    "enterprise-apps/hr-management/*",
    "enterprise-apps/project-management/*",
    "enterprise-apps/finance-accounting/*",
    "enterprise-apps/supply-chain/*",
    "enterprise-apps/business-intelligence/*",
    "enterprise-apps/collaboration-tools/*",
    "games/*",
    "mobile-apps/*",
    "multimedia-apps/*",
    "system-firmware/*",
    "tools-utilities/*",
    "tools-utilities/dev-tools/*",
    "tools-utilities/automation-scripts/*",
    "web-apps/*",
    "packages/*"
  ]
}
